[configuration]

entry_symbol = "game_music_emu_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "./bin/libgame_music_emu.macos.template_debug.universal.dylib"
macos.release = "./bin/libgame_music_emu.macos.template_release.universal.dylib"
windows.debug.x86_64 = "./bin/game_music_emu.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/game_music_emu.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/libgame_music_emu.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libgame_music_emu.linux.template_release.x86_64.so"
android.debug.arm64 = "./bin/libgame_music_emu.android.template_debug.arm64.so"
android.release.arm64 = "./bin/libgame_music_emu.android.template_release.arm64.so"
ios.debug = "./bin/libgame_music_emu.ios.template_debug.xcframework"
ios.release = "./bin/libgame_music_emu.ios.template_release.xcframework"
web.debug.threads.wasm32 = "./bin/libgame_music_emu.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "./bin/libgame_music_emu.web.template_release.wasm32.wasm"
web.debug.wasm32 = "./bin/libgame_music_emu.web.template_debug.wasm32.nothreads.wasm"
web.release.wasm32 = "./bin/libgame_music_emu.web.template_release.wasm32.nothreads.wasm"

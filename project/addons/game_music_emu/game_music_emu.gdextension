[configuration]

entry_symbol = "game_music_emu_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "./bin/libgame_music_emu.macos.template_debug.dylib"
macos.release = "./bin/libgame_music_emu.macos.template_release.dylib"
windows.debug.x86_64 = "./bin/game_music_emu.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/game_music_emu.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/libgame_music_emu.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libgame_music_emu.linux.template_release.x86_64.so"

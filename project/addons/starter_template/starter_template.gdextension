[configuration]

entry_symbol = "starter_template_library_init"
compatibility_minimum = "4.5"
reloadable = true

[libraries]

macos.debug = "./bin/libstarter_template.macos.template_debug.dylib"
macos.release = "./bin/libstarter_template.macos.template_release.dylib"
windows.debug.x86_64 = "./bin/starter_template.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/starter_template.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "./bin/libstarter_template.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/libstarter_template.linux.template_release.x86_64.so"
